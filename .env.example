
# DataFlow Nexus - Local Development Configuration

PROJECT_NAME=DataFlow Nexus
APP_ENV=development

# PostgreSQL
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=dataflow_nexus
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Data generation
DATA_RECORDS=100000
RANDOM_SEED=42

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=nexus_storage_admin
MINIO_ROOT_PASSWORD=replace_with_local_password

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1

# Data Lake Buckets
MINIO_BRONZE_BUCKET=nexus-bronze
MINIO_SILVER_BUCKET=nexus-silver
MINIO_GOLD_BUCKET=nexus-gold